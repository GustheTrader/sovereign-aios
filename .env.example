# === Sovereign AIOS — Environment Configuration ===
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === LLM Providers (4-option strategy) ===

# 1. OpenRouter (Primary — auto-failover)
OPENROUTER_API_KEY=sk-or-v1-replace-me

# 2. Ollama Cloud
OLLAMA_API_KEY=your_ollama_key_here
OLLAMA_BASE_URL=https://ollama.com/v1

# 3. Claude OAuth (Direct — Anthropic)
ANTHROPIC_API_KEY=sk-ant-replace-me

# 4. Local LLM (No API key — sovereign/privacy)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=

# === Fallback Chain Config ===
# Priority order: openrouter → ollama → claude → local
LLM_PROVIDER_FALLBACK_ORDER=openrouter,ollama,claude,local

# === Database ===
DB_USER=multica
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=multica_os

# === Memory Servers ===
OPENAI_API_KEY=sk-replace-me  # Open Brain embeddings + Honcho dialectic reasoning

# === Infrastructure ===
JWT_SECRET=change-me-to-a-random-64-char-hex
WEBUI_SECRET_KEY=change-me-to-a-random-64-char-hex

# === Backup (CSE encrypted before upload) ===
WASABI_ACCESS_KEY=your_wasabi_access_key
WASABI_SECRET_KEY=your_wasabi_secret_key
WASABI_BUCKET_NAME=sovereign-aios-backup
WASABI_ENDPOINT=https://s3.wasabisys.com

BACKBLAZE_B2_APPLICATION_KEY_ID=your_b2_key_id
BACKBLAZE_B2_APPLICATION_KEY=your_b2_application_key
BACKBLAZE_B2_BUCKET_NAME=sovereign-aios-backup
BACKBLAZE_B2_REGION=us-west-001

# === Optional Integrations ===
FIRECRAWL_API_KEY=
KILOCODE_API_KEY=
